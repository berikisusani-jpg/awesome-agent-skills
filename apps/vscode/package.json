{
    "name": "friday-vscode",
    "displayName": "Friday AI Assistant",
    "description": "Your proactive developer companion.",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "friday.explain",
                "title": "Friday: Explain Selection"
            },
            {
                "command": "friday.fix",
                "title": "Friday: Suggest Fix"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/node": "^16.11.7",
        "typescript": "^4.4.4"
    },
    "dependencies": {
        "axios": "^1.4.0"
    }
}
